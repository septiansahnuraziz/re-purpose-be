# Copy to .env and adjust. Viper reads these env vars (dot -> underscore, uppercase).
APP_NAME="RePurpose.ai API"
APP_VERSION="1.0.0"
MODE=dev
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=text

DB_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=repurpose
DB_USER=repurpose
DB_PASSWORD=repurpose
DB_TIMEZONE=Asia/Jakarta
DB_SSL_MODE=disable

ENABLE_CACHING=false
REDIS_CACHE_HOST=redis://127.0.0.1:6379/0
REDIS_WORKER_HOST=redis://127.0.0.1:6379/1

AUTH_BYPASS=true
AUTH_DEMO_USER_ID=usr_demo
AUTH_BCRYPT_COST=12
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ISS=repurpose-ai
AUTH_JWT_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_REFRESH_TTL_SHORT=24h
AUTH_RATE_LIMIT_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW=1m
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Space-separated for Viper string slices (quote the value in .env).
AUTH_GOOGLE_ALLOWED_REDIRECTS="http://localhost:3000 http://127.0.0.1:3000"

LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=120s

EXTRACTOR_TIMEOUT=15s
EXTRACTOR_MAX_CONTENT_LENGTH=200000
